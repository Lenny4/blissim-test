{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Nos produits <small class="text-body-secondary">({{ products|length }})</small></h1>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        {% for product in products %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="{{ product.image }}" class="card-img-top product-img" alt="{{ product.title }}" loading="lazy">
                    <div class="card-body d-flex flex-column">
                        <h2 class="card-title h6">{{ product.title }}</h2>
                        <p class="card-text fw-bold mt-auto mb-2">{{ product.priceCents|format_cents }}</p>
                        <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-outline-primary btn-sm stretched-link">Voir la fiche</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-body-secondary">Aucun produit disponible pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}
