{# Page d'erreur générique affichée en production (APP_ENV=prod) #}
{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <h1 class="display-5">{{ status_code }}</h1>
        <p class="lead">
            {% if status_code == 404 %}
                La page demandée n'existe pas.
            {% else %}
                Une erreur inattendue est survenue.
            {% endif %}
        </p>
        <a href="{{ path('product_index') }}" class="btn btn-primary">Retour au catalogue</a>
    </div>
{% endblock %}
